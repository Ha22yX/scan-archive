<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <DocnetRuntime>win-x64</DocnetRuntime>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\DesktopProtocol.cs" Link="Integration\DesktopProtocol.cs" />
    <Compile Include="..\Shared\UserDataPaths.cs" Link="Integration\UserDataPaths.cs" />
    <Content Include="..\docs\licenses\NAPS2.Wia.txt" Link="NAPS2.Wia.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\docs\licenses\Markdig.txt" Link="Markdig.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="PDFsharp" Version="6.2.2" />
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    <PackageReference Include="NAPS2.Wia" Version="2.0.3" />
  </ItemGroup>


</Project>
